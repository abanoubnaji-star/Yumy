<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What Are We Going to Eat? — yumara</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        yumara: {
                            50: '#f6f8f2',
                            100: '#e7efe0',
                            200: '#d1e0c3',
                            300: '#b0cb9b',
                            400: '#8a9e6e',
                            500: '#6c824e',
                            600: '#4a5d33',
                            700: '#3b4b27',
                            800: '#2d381f',
                            900: '#232d19',
                        },
                        cream: {
                            50: '#faf9f5',
                            100: '#f8f6f0',
                            200: '#f3efe6',
                            300: '#e8e2d4',
                            400: '#d7cdb9',
                            500: '#c2b39b',
                        },
                        forest: {
                            800: '#2d3524',
                            900: '#1b2216',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f6f0;
            color: #2d3524;
        }
        .code-font {
            font-family: 'JetBrains Mono', monospace;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f3efe6; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #d7cdb9; border-radius: 9999px; }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-yumara-600 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- Header Navigation -->
    <header class="bg-white/90 backdrop-blur-md border-b border-cream-300 sticky top-0 z-30 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="flex justify-between items-center h-16">
                <!-- Yumara Logo & Title -->
                <div class="flex items-center space-x-3 cursor-pointer select-none" onclick="app.goHome()">
                    <div class="flex items-center gap-2 text-yumara-600">
                        <svg class="h-8 w-auto fill-current" viewBox="0 0 320 100" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 15 52 A 28 28 0 0 1 71 52 Z M 10 55 L 76 55 A 3 3 0 0 1 76 61 L 10 61 A 3 3 0 0 1 10 55 Z" />
                            <path d="M 83 23 L 83 40 C 83 46 99 46 99 40 L 99 23 L 95 23 L 95 36 L 93 36 L 93 23 L 89 23 L 89 36 L 87 36 L 87 23 Z M 89 44 L 93 44 L 93 68 L 89 68 Z" />
                            <path d="M 103 23 C 111 23 112 38 111 46 L 103 46 Z M 105 48 L 109 48 L 109 68 L 105 68 Z" />
                            <circle cx="73" cy="69" r="3" />
                            <circle cx="82" cy="74" r="2.5" />
                            <circle cx="94" cy="71" r="2" />
                            <circle cx="98" cy="76" r="2.5" />
                            <text x="120" y="65" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="46" letter-spacing="-1">yumara</text>
                        </svg>
                    </div>
                </div>

                <!-- Navigation Controls -->
                <div class="flex items-center space-x-2">
                    <div id="sync-status-indicator" class="inline-flex items-center space-x-1.5 px-2.5 py-1 text-[11px] font-bold rounded-lg bg-cream-200 text-forest-800 border border-cream-300">
                        <span id="sync-dot" class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span id="sync-status-text">Connecting Firestore...</span>
                    </div>

                    <button onclick="app.openHistoryModal()" class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold text-yumara-800 bg-cream-200 hover:bg-cream-300 rounded-lg transition-colors border border-cream-300">
                        <i data-lucide="history" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Order History</span>
                    </button>
                    <button onclick="app.showCreateSessionModal()" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 text-xs font-bold text-white bg-yumara-600 hover:bg-yumara-700 rounded-lg shadow-sm transition-colors">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">New Group Order</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6">

        <!-- VIEW 1: LANDING PAGE -->
        <div id="view-landing" class="flex flex-col items-center justify-center py-6 max-w-4xl mx-auto space-y-8">
            
            <!-- Hero Header -->
            <div class="text-center max-w-xl mx-auto space-y-3">
                <div class="w-16 h-16 mx-auto bg-yumara-100 rounded-2xl flex items-center justify-center text-yumara-600 shadow-inner border border-yumara-200">
                    <i data-lucide="utensils-crossed" class="w-8 h-8"></i>
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-forest-800 tracking-tight">What Are We Eating Today?</h2>
                <p class="text-xs font-bold uppercase tracking-widest text-yumara-600">Egypt's Top Spots • Powered by Talabat &amp; elmenus Menus</p>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Real-time cloud sync across phones &amp; laptops. Split group orders, calculate delivery &amp; taxes in <strong>EGP (ج.م)</strong>, and track payments via InstaPay or Cash.
                </p>
            </div>

            <!-- Quick Action Bar: Join or Create -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-2xl">
                <!-- Join with Code -->
                <div class="bg-white p-4 rounded-2xl border border-cream-300 shadow-sm flex flex-col justify-between space-y-2">
                    <label class="text-xs font-bold text-forest-800 uppercase tracking-wider">Have a Session Code?</label>
                    <div class="flex gap-2">
                        <input type="text" id="join-code-input" maxlength="7" placeholder="e.g. YUM482" 
                               class="code-font uppercase text-center text-base font-extrabold tracking-widest flex-1 px-3 py-2 rounded-xl border border-cream-300 bg-cream-50 text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                        <button onclick="app.joinByCode()" class="px-4 py-2 bg-forest-800 hover:bg-forest-900 text-white font-bold text-xs rounded-xl transition-all flex items-center gap-1 shadow-sm">
                            <span>Join</span>
                            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>

                <!-- Custom Order Button -->
                <div class="bg-white p-4 rounded-2xl border border-cream-300 shadow-sm flex flex-col justify-between space-y-2">
                    <label class="text-xs font-bold text-forest-800 uppercase tracking-wider">Ordering Somewhere Else?</label>
                    <button onclick="app.showCreateSessionModal()" class="w-full py-2.5 bg-yumara-600 hover:bg-yumara-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-yumara-600/20 transition-all flex items-center justify-center gap-2">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span>Start Custom Group Order</span>
                    </button>
                </div>
            </div>

            <!-- RECOMMENDED RESTAURANTS DIRECTORY (Talabat & elmenus) -->
            <div class="w-full space-y-4 pt-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-cream-300 pb-3">
                    <div>
                        <h3 class="text-lg font-extrabold text-forest-800 flex items-center gap-2">
                            <i data-lucide="flame" class="w-5 h-5 text-amber-500"></i>
                            <span>Popular Restaurants in Egypt</span>
                        </h3>
                        <p class="text-xs text-slate-500">Select any spot to launch a group session pre-loaded with menu presets &amp; delivery fees</p>
                    </div>

                    <!-- Live Search Bar -->
                    <div class="relative w-full sm:w-64">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-2.5 text-slate-400"></i>
                        <input type="text" id="restaurant-search-input" oninput="app.filterRestaurants()" placeholder="Search dish, spot, or area..." 
                               class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-cream-300 bg-white text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                    </div>
                </div>

                <!-- Category Filter Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 custom-scrollbar text-xs" id="category-pills">
                    <button onclick="app.setCategoryFilter('all', this)" class="cat-pill active-pill px-3 py-1 rounded-full font-bold border border-yumara-600 bg-yumara-600 text-white transition-colors whitespace-nowrap">All</button>
                    <button onclick="app.setCategoryFilter('traditional', this)" class="cat-pill px-3 py-1 rounded-full font-semibold border border-cream-300 bg-white text-forest-800 hover:bg-cream-100 transition-colors whitespace-nowrap">Traditional &amp; Grills</button>
                    <button onclick="app.setCategoryFilter('koshary_street', this)" class="cat-pill px-3 py-1 rounded-full font-semibold border border-cream-300 bg-white text-forest-800 hover:bg-cream-100 transition-colors whitespace-nowrap">Koshary &amp; Street Food</button>
                    <button onclick="app.setCategoryFilter('burgers_fast', this)" class="cat-pill px-3 py-1 rounded-full font-semibold border border-cream-300 bg-white text-forest-800 hover:bg-cream-100 transition-colors whitespace-nowrap">Burgers &amp; Fast Food</button>
                    <button onclick="app.setCategoryFilter('shawarma', this)" class="cat-pill px-3 py-1 rounded-full font-semibold border border-cream-300 bg-white text-forest-800 hover:bg-cream-100 transition-colors whitespace-nowrap">Syrian Shawarma</button>
                </div>

                <!-- Dynamic Restaurant Grid -->
                <div id="restaurants-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-left">
                    <!-- Populated dynamically via JS -->
                </div>
            </div>
        </div>

        <!-- VIEW 2: UNIFIED COLLABORATIVE BOARD -->
        <div id="view-session" class="hidden space-y-6">

            <!-- Universal Session Banner -->
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-cream-300 shadow-sm relative overflow-hidden">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- 6-Char Session Code Badge -->
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-yumara-100 border border-yumara-300 text-yumara-900 text-xs font-bold">
                                <span>CODE:</span>
                                <span id="session-code-display" class="code-font text-sm font-extrabold tracking-wider">------</span>
                                <button onclick="app.copySessionCode()" title="Copy Code" class="hover:text-yumara-700 ml-1">
                                    <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>

                            <span id="session-lock-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live &amp; Open
                            </span>

                            <button id="admin-mode-toggle-btn" onclick="app.toggleAdminMode()" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-cream-200 hover:bg-cream-300 text-forest-800 border border-cream-300 flex items-center gap-1 transition-colors">
                                <i data-lucide="shield" class="w-3.5 h-3.5 text-yumara-600"></i>
                                <span id="admin-mode-toggle-text">Admin Settings</span>
                            </button>
                        </div>

                        <h2 id="session-restaurant-name" class="text-2xl font-extrabold text-forest-800 tracking-tight pt-1">Restaurant Name</h2>
                        <p id="session-organizer-info" class="text-xs text-slate-500">Organized by Organizer</p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="app.copyUniversalShareLink()" class="inline-flex items-center space-x-2 px-3.5 py-2 text-xs font-bold text-white bg-yumara-600 hover:bg-yumara-700 rounded-xl shadow-sm transition-all">
                            <i data-lucide="share-2" class="w-4 h-4"></i>
                            <span>Copy Link</span>
                        </button>
                        <a id="session-menu-link-btn" href="#" target="_blank" rel="noopener" class="hidden inline-flex items-center space-x-1.5 px-3 py-2 text-xs font-bold text-yumara-800 bg-yumara-50 hover:bg-yumara-100 rounded-xl border border-yumara-200">
                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                            <span>Online Menu</span>
                        </a>
                        <button id="session-menu-img-btn" onclick="app.openMenuImageModal()" class="hidden inline-flex items-center space-x-1.5 px-3 py-2 text-xs font-bold text-forest-800 bg-cream-200 hover:bg-cream-300 rounded-xl border border-cream-300">
                            <i data-lucide="image" class="w-3.5 h-3.5"></i>
                            <span>Menu Photo</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Grid: Left = Add/Edit Form & Order Board, Right = Bill & Admin Controls -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Main Col (col-span-7) -->
                <div class="lg:col-span-7 space-y-6">

                    <!-- QUICK ORDER INPUT FORM -->
                    <div class="bg-white rounded-2xl p-5 border border-cream-300 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="utensils" class="w-4 h-4 text-yumara-600"></i>
                                <h3 id="order-form-header-title" class="font-bold text-forest-800 text-sm sm:text-base">Add or Update Your Order</h3>
                            </div>
                            <span id="order-form-badge" class="hidden px-2 py-0.5 rounded text-[11px] font-bold bg-yumara-100 text-yumara-800 border border-yumara-200">
                                Editing Existing
                            </span>
                        </div>

                        <!-- 1. Name & Payment Method -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider mb-1">Your Name *</label>
                                <input type="text" id="order-input-name" placeholder="e.g. Ahmed, Sarah..." oninput="app.handleNameInputCheck()" 
                                       class="w-full text-xs sm:text-sm px-3 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider mb-1">Payment Method *</label>
                                <div class="grid grid-cols-2 gap-1.5">
                                    <button type="button" id="pay-choice-instapay" onclick="app.setOrderPaymentMethod('InstaPay')" class="py-2 px-2 text-xs font-bold rounded-xl border border-yumara-600 bg-yumara-50 text-yumara-800 flex items-center justify-center space-x-1">
                                        <i data-lucide="smartphone" class="w-3.5 h-3.5"></i>
                                        <span>InstaPay</span>
                                    </button>
                                    <button type="button" id="pay-choice-cash" onclick="app.setOrderPaymentMethod('Cash')" class="py-2 px-2 text-xs font-bold rounded-xl border border-cream-300 bg-cream-100 text-forest-800 flex items-center justify-center space-x-1">
                                        <i data-lucide="banknote" class="w-3.5 h-3.5"></i>
                                        <span>Cash</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Menu Quick Presets -->
                        <div id="board-presets-wrapper" class="hidden space-y-1.5 pt-1">
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Quick Presets</label>
                            <div id="board-presets-list" class="flex flex-wrap gap-1.5"></div>
                        </div>

                        <!-- 2. Items List -->
                        <div class="space-y-2 pt-2 border-t border-cream-200">
                            <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider">Food Items &amp; Prices (EGP)</label>
                            <div id="board-items-inputs" class="space-y-2"></div>

                            <button type="button" onclick="app.addBoardItemRow()" class="w-full py-2 px-3 border border-dashed border-yumara-300 hover:border-yumara-600 hover:bg-yumara-50 text-yumara-700 text-xs font-bold rounded-xl flex items-center justify-center space-x-1.5 transition-all">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                <span>Add Another Item</span>
                            </button>
                        </div>

                        <!-- 3. Notes -->
                        <div>
                            <input type="text" id="order-input-note" placeholder="Special note (e.g. no onions, extra spicy)..." class="w-full text-xs px-3 py-2 rounded-xl border border-cream-300 bg-cream-50 font-medium text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                        </div>

                        <!-- Submit Order Button -->
                        <div class="flex gap-2 pt-1">
                            <button id="btn-submit-order" onclick="app.submitColleagueOrder()" class="flex-1 py-2.5 bg-yumara-600 hover:bg-yumara-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-yumara-600/20 transition-all flex items-center justify-center space-x-2">
                                <i data-lucide="check-circle" class="w-4 h-4"></i>
                                <span id="btn-submit-order-text">Add My Order to Board</span>
                            </button>
                            <button id="btn-cancel-edit" onclick="app.resetOrderForm()" class="hidden px-4 py-2.5 text-xs font-bold text-slate-500 hover:bg-cream-100 border border-cream-300 rounded-xl">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <!-- UNIVERSAL SHARED ORDERS BOARD -->
                    <div class="bg-white rounded-2xl p-5 border border-cream-300 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="users" class="w-5 h-5 text-yumara-600"></i>
                                <h3 class="font-bold text-forest-800 text-base">All Colleagues' Orders</h3>
                            </div>
                            <span id="board-participants-count" class="text-xs font-bold bg-cream-200 px-2.5 py-1 rounded-full text-forest-800 border border-cream-300">
                                0 Orders
                            </span>
                        </div>

                        <!-- Orders Stream -->
                        <div id="board-orders-list" class="space-y-4 divide-y divide-cream-200"></div>
                    </div>

                </div>

                <!-- Right Col: Calculations & Admin Panel (col-span-5) -->
                <div class="lg:col-span-5 space-y-6">

                    <!-- Grand Total Summary Card -->
                    <div class="bg-forest-800 text-white rounded-2xl p-5 shadow-xl space-y-4 border border-forest-900">
                        <div class="flex items-center justify-between border-b border-forest-900/60 pb-3">
                            <h3 class="font-bold text-base text-yumara-300">Total Group Bill</h3>
                            <span class="text-xs bg-forest-900 text-yumara-200 px-2.5 py-0.5 rounded-full font-semibold">EGP / ج.م</span>
                        </div>

                        <div class="space-y-2 text-xs text-cream-200">
                            <div class="flex justify-between">
                                <span>Food Subtotal:</span>
                                <span id="summary-subtotal" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Delivery Fee:</span>
                                <span id="summary-delivery" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Taxes / Service:</span>
                                <span id="summary-tax" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="pt-2 border-t border-forest-900/60 flex justify-between items-baseline text-sm">
                                <span class="font-bold text-white">Grand Total:</span>
                                <span id="summary-grandtotal" class="text-xl font-extrabold text-yumara-300">0.00 EGP</span>
                            </div>
                        </div>

                        <div class="text-[11px] text-yumara-200 bg-forest-900/60 p-2.5 rounded-xl border border-forest-900">
                            <p id="summary-split-explanation">Delivery &amp; taxes are split equally among all members.</p>
                        </div>
                    </div>

                    <!-- ADMIN CONTROLS PANEL -->
                    <div id="admin-panel" class="bg-white rounded-2xl p-5 border border-cream-300 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="sliders" class="w-4 h-4 text-yumara-600"></i>
                                <h3 class="font-bold text-forest-800 text-sm">Admin &amp; Splitting Settings</h3>
                            </div>
                            <button id="admin-lock-btn" onclick="app.toggleLockSession()" class="inline-flex items-center space-x-1.5 px-2.5 py-1 text-xs font-bold text-forest-800 bg-cream-200 hover:bg-cream-300 rounded-lg border border-cream-300">
                                <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                                <span id="admin-lock-btn-text">Lock Orders</span>
                            </button>
                        </div>

                        <div class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Delivery Fee (EGP)</label>
                                <input type="number" id="admin-input-delivery" min="0" step="0.5" placeholder="0.00" oninput="app.updateAdminFees()" class="w-full text-xs px-3 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Tax / Service Charge Type</label>
                                <div class="grid grid-cols-2 gap-1.5 mb-1.5">
                                    <button type="button" id="tax-type-fixed" onclick="app.setTaxType('fixed')" class="py-1.5 text-xs font-bold rounded-lg border border-yumara-600 bg-yumara-50 text-yumara-700">Fixed (EGP)</button>
                                    <button type="button" id="tax-type-percent" onclick="app.setTaxType('percent')" class="py-1.5 text-xs font-bold rounded-lg border border-cream-300 bg-cream-100 text-forest-800">Percentage (%)</button>
                                </div>
                                <input type="number" id="admin-input-tax" min="0" step="0.1" placeholder="0" oninput="app.updateAdminFees()" class="w-full text-xs px-3 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Fee Splitting Mode</label>
