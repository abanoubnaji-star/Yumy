                const url = this.getUniversalShareURL();
                this.fallbackCopyText(url);
                this.showToast('Copied universal link! Send to your group.', 'success');
            }

            copySessionCode() {
                if (this.sessionCode) {
                    this.fallbackCopyText(this.sessionCode);
                    this.showToast(`Copied code: ${this.sessionCode}`, 'success');
                }
