                        spot.name.toLowerCase().includes(this.searchQuery) ||
                        spot.area.toLowerCase().includes(this.searchQuery) ||
                        spot.tags.some(t => t.toLowerCase().includes(this.searchQuery));
                    return matchesCategory && matchesSearch;
                });

