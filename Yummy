            startPreFilledSession(spotId) {
                const spot = this.egyptianSpots.find(s => s.id === spotId);
                if (!spot) return;

                document.getElementById('create-restaurant-name').value = spot.name;
                document.getElementById('create-delivery-fee').value = spot.estDeliveryFee;
                document.getElementById('create-menu-url').value = spot.elmenusUrl;

                this.pendingPresets = spot.popularPresets.map(p => ({
                    id: 'p_' + Math.random().toString(36).substring(2, 6),
                    name: p.name,
                    price: p.price
                }));

                this.showCreateSessionModal();
            }

            async handleCreateSession(event) {
                if (event) event.preventDefault();
                
                const submitBtn = document.getElementById('btn-submit-create');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = 'Creating Session...';
                }

                try {
                    const restName = document.getElementById('create-restaurant-name').value.trim();
                    const adminName = document.getElementById('create-admin-name').value.trim();
                    const menuUrl = document.getElementById('create-menu-url').value.trim();
                    const deliveryFee = parseFloat(document.getElementById('create-delivery-fee').value) || 0;
                    const serviceFee = parseFloat(document.getElementById('create-service-fee').value) || 0;

                    this.sessionCode = this.generateShortCode();

                    this.sessionData = {
                        sessionCode: this.sessionCode,
                        restaurantName: restName,
                        adminName: adminName,
                        menuUrl: menuUrl,
                        menuImage: null,
                        deliveryFee: deliveryFee,
                        serviceFee: serviceFee,
                        taxType: 'fixed',
                        splitMethod: 'equal',
                        isLocked: false,
                        createdAt: new Date().toISOString(),
                        presets: this.pendingPresets && this.pendingPresets.length > 0 ? this.pendingPresets : [],
                        participants: []
                    };

                    this.pendingPresets = null;

                    this.saveSessionToLocalArchive(true);
                    await this.saveSessionDataToFirestore();

                    this.closeModal('modal-create-session');
                    window.location.hash = `#session=${this.sessionCode}`;
                    this.showToast(`Group order ${this.sessionCode} created!`, 'success');

                } catch (err) {
                    console.error('Session creation error:', err);
                    this.showToast('Failed to create session. Please try again.', 'error');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = `<i data-lucide="plus-circle" class="w-4 h-4"></i><span>Create Live Session</span>`;
                        lucide.createIcons();
                    }
                }
            }

            getLocalSession(code) {
                try {
                    const localData = localStorage.getItem(`food_session_${code}`);
                    return localData ? JSON.parse(localData) : null;
                } catch (e) {
                    return null;
                }
            }

            saveSessionToLocalArchive(updateArchiveList = true) {
                try {
                    localStorage.setItem(`food_session_${this.sessionCode}`, JSON.stringify(this.sessionData));
                    
                    if (updateArchiveList) {
                        const history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                        const existingIdx = history.findIndex(h => h.sessionCode === this.sessionCode || h.id === this.sessionCode);
                        const historyEntry = { id: this.sessionCode, ...this.sessionData };

                        if (existingIdx >= 0) {
                            history[existingIdx] = historyEntry;
                        } else {
                            history.unshift(historyEntry);
                        }

                        localStorage.setItem('food_sessions_archive', JSON.stringify(history.slice(0, 30)));
                    }
                } catch (e) {}
            }

            loadSessionState(code) {
                const localData = this.getLocalSession(code);
                if (localData) {
                    this.sessionData = localData;
                }
                this.bindFirestoreListener(code);
            }

            handleRouting() {
                const hash = window.location.hash.substring(1);
                const params = new URLSearchParams(hash);
                const code = params.get('session');

                if (code) {
                    this.sessionCode = code.toUpperCase();
                    this.loadSessionState(this.sessionCode);
                    this.renderSessionBoard();
                } else {
                    if (this.firestoreUnsubscribe) {
                        this.firestoreUnsubscribe();
                        this.firestoreUnsubscribe = null;
                    }
                    this.showLandingView();
                }
            }

            goHome() {
                window.location.hash = '';
                this.showLandingView();
            }

            showLandingView() {
                document.getElementById('view-landing').classList.remove('hidden');
                document.getElementById('view-session').classList.add('hidden');
                this.renderRestaurantsList();
            }

            computeBreakdowns() {
                const participants = this.sessionData.participants || [];
                const count = participants.length;
                const deliveryTotal = this.sessionData.deliveryFee || 0;
                const splitMethod = this.sessionData.splitMethod || 'equal';
                const taxType = this.sessionData.taxType || 'fixed';
                const serviceVal = this.sessionData.serviceFee || 0;

                let groupSubtotal = 0;
                const listWithSubtotals = participants.map(p => {
                    const subtotal = (p.items || []).reduce((s, item) => s + ((parseFloat(item.price) || 0) * (parseInt(item.qty) || 1)), 0);
                    groupSubtotal += subtotal;
                    return { ...p, subtotal };
                });

                let totalTaxEgp = 0;
                if (taxType === 'percent') {
                    totalTaxEgp = (groupSubtotal * serviceVal) / 100;
                } else {
                    totalTaxEgp = serviceVal;
                }

                const calculatedParticipants = listWithSubtotals.map(p => {
                    let deliveryShare = 0;
                    let taxShare = 0;

                    if (splitMethod === 'proportional') {
                        if (groupSubtotal > 0) {
                            const ratio = p.subtotal / groupSubtotal;
                            deliveryShare = ratio * deliveryTotal;
                            taxShare = ratio * totalTaxEgp;
                        } else {
                            deliveryShare = count > 0 ? deliveryTotal / count : 0;
                            taxShare = count > 0 ? totalTaxEgp / count : 0;
                        }
                    } else {
                        deliveryShare = count > 0 ? deliveryTotal / count : 0;
                        taxShare = count > 0 ? totalTaxEgp / count : 0;
                    }

                    const grandTotal = p.subtotal + deliveryShare + taxShare;
                    return { ...p, deliveryShare, taxShare, grandTotal };
                });

                const grandTotalBill = groupSubtotal + deliveryTotal + totalTaxEgp;

                return {
                    groupSubtotal,
                    deliveryTotal,
                    totalTaxEgp,
                    grandTotalBill,
                    participants: calculatedParticipants,
                    count
                };
            }

