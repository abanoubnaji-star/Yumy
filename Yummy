            async initAuth() {
                try {
                    const userCredential = await signInAnonymously(auth);
                    this.user = userCredential.user;
                    this.updateSyncBadge('Connected: Firestore Live', 'bg-emerald-500');
                    if (this.sessionCode && !this.firestoreUnsubscribe) {
                        this.bindFirestoreListener(this.sessionCode);
                    }
                } catch (e) {
                    console.error("Firebase auth error:", e);
                    this.updateSyncBadge('Sync Offline', 'bg-rose-500');
                }
            }

            updateSyncBadge(text, dotColorClass) {
                const syncStatusText = document.getElementById('sync-status-text');
                const syncDot = document.getElementById('sync-dot');
                if (syncStatusText) syncStatusText.innerText = text;
                if (syncDot) syncDot.className = `w-2 h-2 rounded-full ${dotColorClass} animate-pulse`;
            }

            getFirestoreSessionDoc(code) {
                return doc(db, 'food_orders_sessions', code.toUpperCase());
            }

            bindFirestoreListener(code) {
                if (this.firestoreUnsubscribe) {
                    this.firestoreUnsubscribe();
                    this.firestoreUnsubscribe = null;
                }

                if (!this.user) return;

                const docRef = this.getFirestoreSessionDoc(code);
                this.firestoreUnsubscribe = onSnapshot(docRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const remoteData = docSnap.data();
                        this.sessionData = remoteData;
                        this.saveSessionToLocalArchive(false);
                        this.renderSessionBoard();
                        this.updateSyncBadge('Connected: Firestore Live', 'bg-emerald-500');
                    } else {
                        const localData = this.getLocalSession(code);
                        if (localData) {
                            this.sessionData = localData;
                            this.saveSessionDataToFirestore();
                        } else {
                            this.showToast(`Session ${code} not found on cloud`, 'info');
                        }
                    }
                }, (error) => {
                    console.error("Firestore listen error:", error);
                    this.updateSyncBadge('Reconnecting Firestore...', 'bg-amber-500');
                });
            }

            async saveSessionDataToFirestore() {
                if (!this.sessionCode) return;
                try {
                    const docRef = this.getFirestoreSessionDoc(this.sessionCode);
                    await setDoc(docRef, this.sessionData, { merge: true });
                } catch (err) {
                    console.error("Error writing session to Firestore:", err);
                    this.showToast('Failed to sync changes with cloud database', 'error');
                }
            }

            generateShortCode() {
                const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
                let code = '';
                for (let i = 0; i < 6; i++) {
                    code += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return code;
            }

