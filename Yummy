            resetOrderForm() {
                this.currentEditingParticipantId = null;
                document.getElementById('order-input-name').value = '';
                document.getElementById('order-input-note').value = '';
                this.setOrderPaymentMethod('InstaPay');

                const container = document.getElementById('board-items-inputs');
                container.innerHTML = '';
                this.addBoardItemRow();

                document.getElementById('order-form-header-title').innerText = 'Add or Update Your Order';
                document.getElementById('btn-submit-order-text').innerText = 'Add My Order to Board';
                document.getElementById('order-form-badge').classList.add('hidden');
                document.getElementById('btn-cancel-edit').classList.add('hidden');
            }

            async submitColleagueOrder() {
                if (this.sessionData.isLocked) {
                    this.showToast('Orders are locked for this session', 'error');
                    return;
                }

                const name = document.getElementById('order-input-name').value.trim();
                const note = document.getElementById('order-input-note').value.trim();

                if (!name) {
                    this.showToast('Please enter your name', 'error');
                    return;
                }

                const rows = document.querySelectorAll('#board-items-inputs > div');
                const items = [];

                rows.forEach(row => {
                    const nameInput = row.querySelector('.item-name-input');
                    const priceInput = row.querySelector('.item-price-input');
                    const qtyInput = row.querySelector('.item-qty-input');

                    if (nameInput && priceInput && qtyInput) {
                        const itemName = nameInput.value.trim();
                        const itemPrice = parseFloat(priceInput.value) || 0;
                        const itemQty = parseInt(qtyInput.value) || 1;

                        if (itemName && itemPrice >= 0) {
                            items.push({ name: itemName, price: itemPrice, qty: itemQty });
                        }
                    }
                });

                if (items.length === 0) {
                    this.showToast('Please enter at least one food item with a price', 'error');
                    return;
                }

                const participants = [...(this.sessionData.participants || [])];

                let targetIndex = -1;
                if (this.currentEditingParticipantId) {
                    targetIndex = participants.findIndex(p => p.id === this.currentEditingParticipantId);
                } else {
                    targetIndex = participants.findIndex(p => p.name.toLowerCase() === name.toLowerCase());
                }

                let savedParticipant = null;

                if (targetIndex >= 0) {
                    participants[targetIndex].name = name;
                    participants[targetIndex].items = items;
                    participants[targetIndex].paymentMethod = this.selectedPaymentMethod;
                    participants[targetIndex].note = note;
                    savedParticipant = participants[targetIndex];
                    this.showToast(`Updated ${name}'s order!`, 'success');
                } else {
                    savedParticipant = {
                        id: 'part_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 5),
                        name: name,
                        items: items,
                        paymentMethod: this.selectedPaymentMethod,
                        note: note,
                        isPaid: false
                    };
                    participants.push(savedParticipant);
                    this.showToast(`Added ${name}'s order to the board!`, 'success');
                }

                this.sessionData.participants = participants;
                this.saveSessionToLocalArchive(true);
                await this.saveSessionDataToFirestore();

                this.resetOrderForm();
            }

            async togglePaymentStatus(id) {
                const participants = [...this.sessionData.participants];
                const p = participants.find(item => item.id === id);
                if (p) {
                    p.isPaid = !p.isPaid;
                    this.sessionData.participants = participants;
                    this.saveSessionToLocalArchive(true);
                    await this.saveSessionDataToFirestore();
                }
            }

            promptRemoveParticipant(id) {
                const p = (this.sessionData.participants || []).find(x => x.id === id);
                const name = p ? p.name : 'this order';
                this.showConfirmDialog(`Remove Order?`, `Are you sure you want to remove ${name}'s order from the session?`, async () => {
                    this.sessionData.participants = this.sessionData.participants.filter(item => item.id !== id);
                    this.saveSessionToLocalArchive(true);
                    await this.saveSessionDataToFirestore();
                    this.showToast('Order removed', 'info');
                    if (this.currentEditingParticipantId === id) {
                        this.resetOrderForm();
                    }
                });
            }

