            updateTaxTypeUI(type) {
                const fixedBtn = document.getElementById('tax-type-fixed');
                const percentBtn = document.getElementById('tax-type-percent');

                if (type === 'percent') {
                    percentBtn.className = 'py-1.5 text-xs font-bold rounded-lg border border-yumara-600 bg-yumara-50 text-yumara-700';
                    fixedBtn.className = 'py-1.5 text-xs font-bold rounded-lg border border-cream-300 bg-cream-100 text-forest-800';
                } else {
                    fixedBtn.className = 'py-1.5 text-xs font-bold rounded-lg border border-yumara-600 bg-yumara-50 text-yumara-700';
                    percentBtn.className = 'py-1.5 text-xs font-bold rounded-lg border border-cream-300 bg-cream-100 text-forest-800';
                }
            }

            async updateAdminFees() {
                this.sessionData.deliveryFee = parseFloat(document.getElementById('admin-input-delivery').value) || 0;
                this.sessionData.serviceFee = parseFloat(document.getElementById('admin-input-tax').value) || 0;
                this.sessionData.splitMethod = document.getElementById('admin-select-split').value;
                this.saveSessionToLocalArchive(true);
                await this.saveSessionDataToFirestore();
                this.renderOrdersStream();
            }

            async toggleLockSession() {
                this.sessionData.isLocked = !this.sessionData.isLocked;
                this.saveSessionToLocalArchive(true);
                await this.saveSessionDataToFirestore();
                this.showToast(this.sessionData.isLocked ? 'Orders locked' : 'Orders unlocked', 'info');
            }

            showCreateSessionModal() {
                document.getElementById('modal-create-session').classList.remove('hidden');
                lucide.createIcons();
            }

            openAdminMenuModal() {
                const text = (this.sessionData.presets || []).map(p => `${p.name} - ${p.price}`).join('\n');
                document.getElementById('quick-preset-paste').value = text;
                document.getElementById('modal-admin-menu').classList.remove('hidden');
            }

            async parseAndAddPresets() {
                const rawText = document.getElementById('quick-preset-paste').value;
                const lines = rawText.split('\n');
                const newPresets = [];

                lines.forEach(line => {
                    const parts = line.split('-');
                    if (parts.length >= 2) {
                        const priceStr = parts.pop().trim();
                        const nameStr = parts.join('-').trim();
                        const price = parseFloat(priceStr);

                        if (nameStr && !isNaN(price)) {
                            newPresets.push({
                                id: 'p_' + Math.random().toString(36).substring(2, 6),
                                name: nameStr,
                                price: price
                            });
                        }
                    }
                });

                this.sessionData.presets = newPresets;
                this.saveSessionToLocalArchive(true);
                await this.saveSessionDataToFirestore();
                this.closeModal('modal-admin-menu');
                this.showToast('Presets saved!', 'success');
            }

            async clearPresets() {
                this.sessionData.presets = [];
                document.getElementById('quick-preset-paste').value = '';
                this.saveSessionToLocalArchive(true);
                await this.saveSessionDataToFirestore();
                this.closeModal('modal-admin-menu');
            }

            openHistoryModal() {
                document.getElementById('modal-history').classList.remove('hidden');
                this.renderHistoryList();
            }

            renderHistoryList() {
                const container = document.getElementById('history-sessions-list');
                let history = [];
                try {
                    history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                } catch (e) {}

                if (history.length === 0) {
                    container.innerHTML = `<p class="text-center text-xs text-slate-400 py-6">No past sessions found in history.</p>`;
                    return;
                }

                container.innerHTML = history.map(item => {
                    const code = item.sessionCode || item.id;
                    const parts = item.participants || [];
                    const totalSub = parts.reduce((s, p) => s + (p.items || []).reduce((iS, i) => iS + (i.price * i.qty), 0), 0);
                    const grandTotal = totalSub + (item.deliveryFee || 0) + (item.serviceFee || 0);

                    return `
                        <div class="flex items-center justify-between p-3.5 bg-cream-50 hover:bg-cream-100 rounded-xl border border-cream-300">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-sm text-forest-800">${this.escapeHtml(item.restaurantName)}</h4>
                                    <span class="code-font text-[11px] font-bold px-1.5 py-0.5 rounded bg-yumara-100 text-yumara-800 border border-yumara-200">${code}</span>
                                </div>
                                <p class="text-xs text-slate-500 mt-0.5">${new Date(item.createdAt).toLocaleDateString('en-GB')} • Organizer: ${this.escapeHtml(item.adminName)}</p>
                                <p class="text-[11px] font-bold text-yumara-700 mt-0.5">${grandTotal.toFixed(2)} EGP (${parts.length} Participants)</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button onclick="app.loadHistoricalSession('${code}')" class="px-3 py-1.5 bg-yumara-600 hover:bg-yumara-700 text-white text-xs font-bold rounded-lg shadow-sm">
                                    Open
                                </button>
                                <button onclick="app.promptDeleteHistoricalSession('${code}')" class="p-1.5 text-rose-600 hover:bg-rose-100 rounded-lg transition-colors" title="Delete Session">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');

                lucide.createIcons();
            }

            promptDeleteHistoricalSession(code) {
                this.showConfirmDialog(`Delete Session ${code}?`, `This will remove the session from your history archive.`, async () => {
                    let history = [];
                    try {
                        history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                    } catch (e) {}

                    history = history.filter(item => (item.sessionCode || item.id) !== code);
                    localStorage.setItem('food_sessions_archive', JSON.stringify(history));
                    localStorage.removeItem(`food_session_${code}`);

                    this.showToast('Session deleted from history', 'info');
                    this.renderHistoryList();
                });
            }

            promptClearAllHistory() {
                this.showConfirmDialog('Clear All History?', 'Are you sure you want to clear ALL past session history? This cannot be undone.', async () => {
                    let history = [];
                    try {
                        history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                    } catch (e) {}

                    history.forEach(item => {
                        localStorage.removeItem(`food_session_${item.sessionCode || item.id}`);
                    });

                    localStorage.removeItem('food_sessions_archive');
                    this.showToast('History cleared', 'info');
                    this.renderHistoryList();
                });
            }

            loadHistoricalSession(code) {
                this.closeModal('modal-history');
                window.location.hash = `#session=${code}`;
            }

            showConfirmDialog(title, message, onConfirm) {
                const modal = document.getElementById('modal-custom-confirm');
                document.getElementById('custom-confirm-title').innerText = title;
                document.getElementById('custom-confirm-message').innerText = message;

                const acceptBtn = document.getElementById('custom-confirm-accept-btn');
                const cancelBtn = document.getElementById('custom-confirm-cancel-btn');

                const cleanup = () => {
                    modal.classList.add('hidden');
                    acceptBtn.onclick = null;
                    cancelBtn.onclick = null;
                };

                acceptBtn.onclick = () => {
                    cleanup();
                    if (typeof onConfirm === 'function') onConfirm();
                };

                cancelBtn.onclick = cleanup;
                modal.classList.remove('hidden');
                lucide.createIcons();
            }

            fallbackCopyText(text) {
                const textArea = document.createElement("textarea");
                textArea.value = text;
                textArea.style.position = "fixed";
                textArea.style.left = "-9999px";
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                } catch (err) {}
                document.body.removeChild(textArea);
            }

            openMenuImageModal() {
                if (this.sessionData.menuImage) {
                    document.getElementById('modal-menu-img-element').src = this.sessionData.menuImage;
                    document.getElementById('modal-menu-image').classList.remove('hidden');
                }
            }

            closeModal(id) {
                document.getElementById(id).classList.add('hidden');
            }

            showToast(message, type = 'info') {
                const container = document.getElementById('toast-container');
                if (!container) return;
                
                const toast = document.createElement('div');
                const bg = type === 'success' ? 'bg-yumara-700' : type === 'error' ? 'bg-rose-800' : 'bg-forest-800';

                toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg font-medium text-xs text-white transition-all transform translate-y-2 opacity-0 ${bg}`;
                toast.innerHTML = `<span>${this.escapeHtml(message)}</span>`;

                container.appendChild(toast);
                setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
                setTimeout(() => {
                    toast.classList.add('opacity-0', 'translate-y-2');
                    setTimeout(() => toast.remove(), 250);
                }, 3000);
            }

            escapeHtml(str) {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
        }

        window.app = new FoodOrderApp();
    </script>
</body>
</html>
